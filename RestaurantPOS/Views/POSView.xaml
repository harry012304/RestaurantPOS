<UserControl x:Class="RestaurantPOS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- MENU SIDE -->
        <!-- ===================== -->

        <Grid Grid.Column="0"
              Margin="0,0,25,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="Point of Sale"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Select products to create an order"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <!-- Order Type -->

            <StackPanel Grid.Row="1"
            Margin="0,0,0,15">

                <TextBlock Text="Order Type"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#374151"
               Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">

                    <ComboBox x:Name="OrderTypeComboBox"
                  Width="180"
                  Height="38"
                  SelectionChanged="OrderTypeComboBox_SelectionChanged">

                        <ComboBoxItem Content="Dine-In"/>
                        <ComboBoxItem Content="Takeaway"/>

                    </ComboBox>

                    <StackPanel x:Name="TableSelectionPanel"
                    Orientation="Horizontal"
                    Margin="20,0,0,0"
                    Visibility="Collapsed">

                        <TextBlock Text="Table:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="SemiBold"/>

                        <ComboBox x:Name="TableComboBox"
                      Width="150"
                      Height="38"
                      DisplayMemberPath="TableNumber"
                      SelectionChanged="TableComboBox_SelectionChanged"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

            <!-- Category Filter -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,20">

                <TextBlock Text="Category:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="CategoryComboBox"
                          Width="200"
                          Height="38"
                          DisplayMemberPath="Name"
                          SelectionChanged="CategoryComboBox_SelectionChanged"/>

            </StackPanel>
            
            

            <!-- Products -->

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ProductsItemsControl">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Width="190"
                                    Height="170"
                                    Margin="0,0,15,15"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="18">

                                <Border.Effect>

                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.08"/>

                                </Border.Effect>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Price,
                                                StringFormat='RM {0:N2}'}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#2563EB"
                                                   Margin="0,12,0,0"/>

                                        <TextBlock Text="{Binding StockQuantity,
                                                StringFormat='Stock: {0}'}"
                                                   Foreground="#6B7280"
                                                   FontSize="12"
                                                   Margin="0,7,0,0"/>

                                    </StackPanel>

                                    <Button Grid.Row="1"
                                            Content="Add to Order"
                                            Tag="{Binding}"
                                            Click="AddProductButton_Click"
                                            Height="38"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

        <!-- ===================== -->
        <!-- CART SIDE -->
        <!-- ===================== -->

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="14"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,20">

                    <TextBlock Text="Current Order"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Add menu items to the order"
                               Foreground="#6B7280"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- Cart items -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="CartItemsControl">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="{Binding ProductName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="#111827"/>

                                            <TextBlock Text="{Binding UnitPrice,
                                                    StringFormat='RM {0:N2}'}"
                                                       Foreground="#6B7280"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding Total,
                                                    StringFormat='RM {0:N2}'}"
                                                       Foreground="#2563EB"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Button Content="-"
                                                    Width="30"
                                                    Height="30"
                                                    Tag="{Binding}"
                                                    Click="DecreaseButton_Click"/>

                                            <TextBlock Text="{Binding Quantity}"
                                                       Width="35"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>

                                            <Button Content="+"
                                                    Width="30"
                                                    Height="30"
                                                    Tag="{Binding}"
                                                    Click="IncreaseButton_Click"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <!-- Totals -->

                <StackPanel Grid.Row="2"
                            Margin="0,20,0,0">

                    <Separator Margin="0,0,0,15"/>

                    <Grid>

                        <TextBlock Text="Subtotal"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="SubtotalTextBlock"
                                   Text="RM 0.00"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"/>

                    </Grid>

                    <Grid Margin="0,12,0,0">

                        <TextBlock Text="Tax (6%)"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TaxTextBlock"
                                   Text="RM 0.00"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <Grid Margin="0,15,0,0">

                        <TextBlock Text="Total"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TotalTextBlock"
                                   Text="RM 0.00"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <Button Content="Proceed to Payment"
                            Height="50"
                            Margin="0,25,0,0"
                            Background="#16A34A"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PaymentButton_Click"/>

                    <Button Content="Clear Order"
                            Height="40"
                            Margin="0,10,0,0"
                            Background="#F3F4F6"
                            Foreground="#DC2626"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ClearOrderButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>