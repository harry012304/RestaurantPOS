<Window x:Class="RestaurantPOS.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt"
        Height="720"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RECEIPT -->

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <Border x:Name="ReceiptBorder"
                    Width="360"
                    Background="White"
                    Padding="25"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <!-- Restaurant -->

                    <TextBlock Text="RESTAURANT POS"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Thank you for dining with us"
                               FontSize="12"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,20"/>

                    <Separator/>

                    <!-- ORDER INFO -->

                    <Grid Margin="0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock x:Name="OrderNumberTextBlock"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="OrderDateTextBlock"
                                       Margin="0,5,0,0"/>

                            <TextBlock x:Name="OrderTypeTextBlock"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <TextBlock x:Name="TableTextBlock"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Top"/>

                    </Grid>

                    <Separator/>

                    <!-- ITEMS -->

                    <ItemsControl x:Name="ReceiptItemsControl"
                                  Margin="0,15">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding ProductName}"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding UnitPrice,
                                            StringFormat='RM {0:N2}'}"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Quantity,
                                               StringFormat='x{0}'}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Total,
                                               StringFormat='RM {0:N2}'}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Separator/>

                    <!-- TOTALS -->

                    <Grid Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Subtotal"/>

                        <TextBlock x:Name="SubtotalTextBlock"
                                   Grid.Column="1"/>

                    </Grid>

                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Tax (6%)"/>

                        <TextBlock x:Name="TaxTextBlock"
                                   Grid.Column="1"/>

                    </Grid>

                    <Grid Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="TOTAL"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TotalTextBlock"
                                   Grid.Column="1"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                    </Grid>

                    <Separator Margin="0,15"/>

                    <!-- PAYMENT -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Payment Method"/>

                        <TextBlock x:Name="PaymentMethodTextBlock"
                                   Grid.Column="1"/>

                    </Grid>

                    <Grid Margin="0,7,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Cash Received"/>

                        <TextBlock x:Name="AmountReceivedTextBlock"
                                   Grid.Column="1"/>

                    </Grid>

                    <Grid Margin="0,7,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Change"/>

                        <TextBlock x:Name="ChangeTextBlock"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"/>

                    </Grid>

                    <Separator Margin="0,20"/>

                    <!-- FOOTER -->

                    <TextBlock Text="Thank you!"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Please come again"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- BUTTONS -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

            <Button Content="Print Receipt"
                    Width="140"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="PrintButton_Click"/>

            <Button Content="Close"
                    Width="100"
                    Height="45"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>