<UserControl x:Class="RestaurantPOS.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RestaurantPOS.Converters"
             Background="#F3F4F6">

    <UserControl.Resources>

        <converters:StatusToColorConverter
        x:Key="StatusToColorConverter"/>

        <converters:StatusToTextColorConverter
        x:Key="StatusToTextColorConverter"/>

    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="40">

            <!-- Header -->
            <TextBlock Text="Table Management"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="View and manage restaurant tables"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,7,0,30"/>

            <!-- Table Cards -->
            <ItemsControl x:Name="TablesItemsControl">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>

                        <WrapPanel/>

                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Width="220"
                                Height="160"
                                Margin="0,0,20,20"
                                Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Cursor="Hand"
                                MouseLeftButtonUp="TableCard_Click">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Opacity="0.08"/>
                            </Border.Effect>

                            <StackPanel>

                                <TextBlock Text="{Binding TableNumber}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>

                                <TextBlock FontSize="14"
                                           Foreground="#6B7280"
                                           Margin="0,10,0,0">

                                    <Run Text="{Binding Capacity}"/>
                                    <Run Text=" Seats"/>

                                </TextBlock>

                                <Border Margin="0,18,0,0"
                                    Background="{Binding Status,
                                        Converter={StaticResource StatusToColorConverter}}"
                                    CornerRadius="15"
                                    HorizontalAlignment="Left"
                                    Padding="12,6">

                                                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status,
                                               Converter={StaticResource StatusToTextColorConverter}}"/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</UserControl>