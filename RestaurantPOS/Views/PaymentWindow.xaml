<Window x:Class="RestaurantPOS.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment"
        Height="700"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="30">

        <Border Background="White"
                CornerRadius="15"
                Padding="30">

            <StackPanel>

                <TextBlock Text="Payment"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Complete customer payment"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <!-- Total -->

                <TextBlock Text="Amount Due"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="TotalTextBlock"
                           Text="RM 0.00"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <!-- Payment Method -->

                <TextBlock Text="Payment Method"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="PaymentMethodComboBox"
                          Height="42"
                          SelectedIndex="0">

                    <ComboBoxItem Content="Cash"/>

                </ComboBox>

                <!-- Amount Received -->

                <TextBlock Text="Cash Received"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>

                <TextBox x:Name="AmountReceivedTextBox"
                         Height="42"
                         FontSize="16"
                         Padding="10"
                         TextChanged="AmountReceivedTextBox_TextChanged"/>

                <!-- Change -->

                <Grid Margin="0,25,0,0">

                    <TextBlock Text="Change"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ChangeTextBlock"
                               Text="RM 0.00"
                               HorizontalAlignment="Right"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#16A34A"/>

                </Grid>

                <!-- Error -->

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#DC2626"
                           Margin="0,15,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Confirm -->

                <Button Content="Confirm Payment"
                        Height="48"
                        Margin="0,20,0,0"
                        Background="#16A34A"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ConfirmPaymentButton_Click"/>

                <Button Content="Cancel"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>