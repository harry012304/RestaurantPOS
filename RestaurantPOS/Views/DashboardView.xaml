<UserControl x:Class="RestaurantPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="#111827">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Margin="5,20,5,40">

                    <TextBlock Text="RestaurantPOS"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="Management System"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <Button x:Name="DashboardButton"
                            Content="Dashboard"
                            Click="DashboardButton_Click"
                            Height="45"
                            Margin="0,0,0,8"
                            Foreground="White"
                            Background="#2563EB"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="POSButton"
                            Content="POS"
                            Click="POSButton_Click"
                            Height="45"
                            Margin="0,0,0,8"
                            Foreground="#D1D5DB"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="TablesButton"
                        Content="Tables"
                        Click="TablesButton_Click"
                        Height="45"
                        Margin="0,0,0,8"
                        Foreground="#D1D5DB"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"/>

                    <Button x:Name="MenuButton"
                            Content="Menu"
                            Click="MenuButton_Click"
                            Height="45"
                            Margin="0,0,0,8"
                            Foreground="#D1D5DB"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="InventoryButton"
                            Content="Inventory"
                            Click="InventoryButton_Click"
                            Height="45"
                            Margin="0,0,0,8"
                            Foreground="#D1D5DB"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="SalesButton"
                        Content="Sales"
                        Click="SalesButton_Click"
                        Height="45"
                        Margin="0,0,0,8"
                        Foreground="#D1D5DB"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"/>

                </StackPanel>

                <!-- Logout -->
                <Button Grid.Row="2"
                        Content="Logout"
                        Click="LogoutButton_Click"
                        Height="45"
                        Foreground="White"
                        Background="#DC2626"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Margin="0,20,0,10"/>

            </Grid>

        </Border>

        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="DashboardContent"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="40">

                <!-- HEADER -->

                <Grid Margin="0,0,0,35">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Dashboard"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="WelcomeTextBlock"
                                   Text="Welcome"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   Margin="0,7,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <TextBlock x:Name="UserNameTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="RoleTextBlock"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

                <!-- STAT CARDS -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SALES -->

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="Today's Sales"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                            <TextBlock x:Name="TodaySalesTextBlock"
                                       Text="RM 0.00"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- ORDERS -->

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            Margin="10,0">

                        <StackPanel>

                            <TextBlock Text="Orders"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                                <TextBlock x:Name="OrdersCountTextBlock"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,10,0,0"/>

                            </StackPanel>

                    </Border>

                    <!-- PRODUCTS -->

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            Margin="10,0">

                        <StackPanel>

                            <TextBlock Text="Products"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                                <TextBlock x:Name="ProductsCountTextBlock"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,10,0,0"/>

                            </StackPanel>

                    </Border>

                    <!-- LOW STOCK -->

                    <Border Grid.Column="3"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            Margin="10,0,0,0">

                        <StackPanel>

                            <TextBlock Text="Low Stock"
                                       Foreground="#6B7280"
                                       FontSize="13"/>

                                <TextBlock x:Name="LowStockCountTextBlock"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       Margin="0,10,0,0"/>

                            </StackPanel>

                    </Border>

                </Grid>

                <!-- SECOND SECTION -->

                <Grid Margin="0,35,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RECENT SALES -->

                        <Border Grid.Column="0"
        Background="White"
        Padding="25"
        CornerRadius="12"
        Margin="0,0,15,0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Recent Sales"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,15"/>

                                <DataGrid x:Name="RecentSalesDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False">   

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Order"
                                    Binding="{Binding OrderNumber}"
                                    Width="75"/>

                                        <DataGridTextColumn Header="Type"
                                    Binding="{Binding OrderType}"
                                    Width="100"/>

                                        <DataGridTextColumn Header="Table"
                                    Binding="{Binding TableNumber}"
                                    Width="80"/>

                                        <DataGridTextColumn Header="Total"
                                    Binding="{Binding Total,
                                    StringFormat='RM {0:N2}'}"
                                    Width="110"/>

                                        <DataGridTextColumn Header="Time"
                                    Binding="{Binding OrderDate,
                                    StringFormat='HH:mm'}"
                                    Width="80"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                        <!-- POPULAR ITEMS -->

                        <Border Grid.Column="1"
        Background="White"
        Padding="25"
        CornerRadius="12"
        Margin="15,0,0,0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Popular Items"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,15"/>

                                <ItemsControl x:Name="PopularItemsControl"
                      Grid.Row="1">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="0,12">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding ProductName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                                                    <TextBlock Grid.Column="1"
                                       Text="{Binding QuantitySold,
                                       StringFormat='{}{0} sold'}"
                                       Foreground="#2563EB"
                                       FontWeight="SemiBold"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </Grid>

                        </Border>

                    </Grid>

            </StackPanel>

            </ScrollViewer>

            <ContentControl x:Name="PageContent"
                    Visibility="Collapsed"/>

        </Grid>

    </Grid>

</UserControl>