<UserControl x:Class="RestaurantPOS.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Menu Management"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Add and manage restaurant menu items"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Add New Item"
                    Width="140"
                    Height="42"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="AddNewButton_Click"/>

        </Grid>

        <!-- CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- PRODUCT LIST -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,20,0">

                <DataGrid x:Name="ProductsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="ProductsDataGrid_SelectionChanged"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category.Name}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Price"
                                            Binding="{Binding Price,
                                            StringFormat='RM {0:N2}'}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding StockQuantity}"
                                            Width="90"/>

                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsAvailable}"
                                                Width="80"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- EDIT FORM -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock x:Name="FormTitleTextBlock"
                                   Text="Select a menu item"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,25"/>

                        <!-- NAME -->

                        <TextBlock Text="Product Name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="NameTextBox"
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"/>

                        <!-- CATEGORY -->

                        <TextBlock Text="Category"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                        <ComboBox x:Name="CategoryComboBox"
                                  Height="40"
                                  DisplayMemberPath="Name"/>

                        <!-- PRICE -->

                        <TextBlock Text="Price (RM)"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                        <TextBox x:Name="PriceTextBox"
                                 Height="40"
                                 Padding="10"/>

                        <!-- STOCK -->

                        <TextBlock Text="Stock Quantity"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                        <TextBox x:Name="StockTextBox"
                                 Height="40"
                                 Padding="10"/>

                        <!-- ERROR -->

                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0"/>

                        <!-- SAVE -->

                        <Button Content="Save"
                                Height="45"
                                Margin="0,20,0,0"
                                Background="#16A34A"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SaveButton_Click"/>

                        <!-- DEACTIVATE -->

                        <Button x:Name="DeactivateButton"
                                Content="Deactivate"
                                Height="42"
                                Margin="0,10,0,0"
                                Background="#FEE2E2"
                                Foreground="#B91C1C"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="DeactivateButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>