<UserControl x:Class="RestaurantPOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Inventory Management"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Monitor stock levels and restock menu items"
                       Foreground="#6B7280"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- SUMMARY + SEARCH -->

        <Grid Grid.Row="1"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL PRODUCTS -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Width="170"
                    Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock Text="Products"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="TotalProductsTextBlock"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- LOW STOCK -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Width="170">

                <StackPanel>

                    <TextBlock Text="Low / Out of Stock"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="LowStockTextBlock"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- SEARCH -->

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock Text="Search Product"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="SearchTextBox"
                         Width="260"
                         Height="40"
                         Padding="10"
                         TextChanged="SearchTextBox_TextChanged"/>

            </StackPanel>

        </Grid>

        <!-- MAIN AREA -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- INVENTORY LIST -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,20,0">

                <DataGrid x:Name="InventoryDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="InventoryDataGrid_SelectionChanged"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding StockQuantity}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StockStatus}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Price"
                                            Binding="{Binding Price,
                                            StringFormat='RM {0:N2}'}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- RESTOCK PANEL -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Restock Product"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Select a product from the inventory list"
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,0,25"/>

                    <TextBlock Text="Selected Product"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="SelectedProductTextBlock"
                               Text="None"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="0,8,0,20"/>

                    <TextBlock Text="Current Stock"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="CurrentStockTextBlock"
                               Text="-"
                               FontSize="20"
                               Margin="0,8,0,20"/>

                    <TextBlock Text="Quantity to Add"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="RestockQuantityTextBox"
                             Height="42"
                             Padding="10"/>

                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="#DC2626"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <Button Content="Add Stock"
                            Height="45"
                            Margin="0,20,0,0"
                            Background="#16A34A"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RestockButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>