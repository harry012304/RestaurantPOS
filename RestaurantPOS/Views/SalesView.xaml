<UserControl x:Class="RestaurantPOS.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Sales History"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="View completed restaurant transactions"
                       Foreground="#6B7280"
                       FontSize="14"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- SALES LIST -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <DataGrid x:Name="OrdersDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="OrdersDataGrid_SelectionChanged"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Order"
                                        Binding="{Binding Id, StringFormat='# {0}'}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding OrderDate,
                                        StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding OrderType}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Table"
                                        Binding="{Binding RestaurantTable.TableNumber}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Subtotal"
                                        Binding="{Binding Subtotal,
                                        StringFormat='RM {0:N2}'}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Tax"
                                        Binding="{Binding Tax,
                                        StringFormat='RM {0:N2}'}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding Total,
                                        StringFormat='RM {0:N2}'}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Payment"
                                        Binding="{Binding PaymentMethod}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- ORDER DETAILS -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="OrderDetailsTitle"
                               Text="Select an order to view items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="OrderTotalTextBlock"
                               Grid.Column="1"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#2563EB"/>

                </Grid>

                <DataGrid x:Name="OrderItemsDataGrid"
                          Grid.Row="1"
                          Margin="0,15,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Price"
                                            Binding="{Binding UnitPrice,
                                            StringFormat='RM {0:N2}'}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total,
                                            StringFormat='RM {0:N2}'}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>